# ============================================
# Required application secrets
# ============================================
# Generate stable values once and keep them unchanged across upgrades.
# Example: openssl rand -hex 32
JWT_SECRET_KEY=
MCP_ENCRYPTION_SALT=

# ============================================
# LLM Configuration
# ============================================
# Configure models via the Model Config UI after deployment.

# ============================================
# E2B Sandbox Configuration
# ============================================
E2B_API_KEY=
E2B_TEMPLATE=base


# ============================================
# Sandbox configuration (socket-free by default)
# ============================================
ENABLE_SANDBOX=false
SANDBOX_PLATFORM=daytona
DOCKER_SANDBOX_NAMESPACE=default
DOCKER_SANDBOX_IMAGE=python:3.12-slim-bookworm
DOCKER_SANDBOX_TIMEOUT=180
DOCKER_SANDBOX_IDLE_TIMEOUT=1800
DOCKER_SANDBOX_CLEANUP_INTERVAL=60
DOCKER_SANDBOX_MAX_CONTAINERS=20
DOCKER_SANDBOX_MEMORY_LIMIT_MB=1024
DOCKER_SANDBOX_CPU_LIMIT=1.0
DOCKER_SANDBOX_PIDS_LIMIT=256
DOCKER_SANDBOX_NETWORK_MODE=bridge
DOCKER_SANDBOX_MAX_OUTPUT_BYTES=10485760

# To explicitly enable local Docker sandboxes on a trusted Linux host:
# DOCKER_GID="$(stat -c '%g' /var/run/docker.sock)"
# COMPOSE_FILE=docker-compose.yml:docker-compose.docker-sandbox.yml
# SANDBOX_PLATFORM=docker
# ENABLE_SANDBOX=true
